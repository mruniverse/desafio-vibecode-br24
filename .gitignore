# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NUNCA versionar (requisito: sem tokens no codigo-fonte).
# A excecao e o .env.example, que tem apenas placeholders.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Banco SQLite local — contem tokens cifrados e dados do cliente.
# A pasta /data e exigencia do desafio, mas o CONTEUDO nunca vai pro git.
# ---------------------------------------------------------------------------
/data/*
!/data/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm

# artefatos de deploy
/*.zip

# evidencias do spike Bitrix (dados de portal real; nunca versionar nem empacotar)
/spike/
