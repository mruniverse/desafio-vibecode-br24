# ---------------------------------------------------------------------------
# Desafio Vibecode Br24 — variaveis de ambiente
# Copie para `.env.local` (dev) ou configure no painel da Onnira Cloud AI.
# NUNCA faca commit de valores reais. Este arquivo tem apenas placeholders.
# ---------------------------------------------------------------------------

# Chave mestra usada para cifrar os tokens do Bitrix24 em repouso (AES-256-GCM).
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY

# URL publica da aplicacao (usada no redirect do OAuth do Bitrix24).
# Em producao: a URL que a Onnira Cloud AI atribuir ao app.
APP_BASE_URL=http://localhost:3000

# Credenciais do "aplicativo local" criado no portal do cliente
# (Bitrix24 > Aplicativos > Desenvolvedores > Outro > Aplicativo local).
# Opcional: o wizard tambem permite que o proprio cliente informe estes valores
# pela interface, sem tocar no codigo. Os valores aqui sao apenas um default.
BITRIX_CLIENT_ID=YOUR_BITRIX_CLIENT_ID
BITRIX_CLIENT_SECRET=YOUR_BITRIX_CLIENT_SECRET

# Caminho do banco SQLite. Default: ./data/app.db (exigencia do desafio: pasta /data)
DATABASE_PATH=./data/app.db

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info
